{
  "admin": {
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "harmony": {
          "listen": [
            ":8080"
          ],
          "routes": [
            {
              "match": [
                {
                  "path": [
                    "/api/internal/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            },
            {
              "match": [
                {
                  "path": [
                    "/api/files/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "request_body",
                  "max_size": 26214400
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "100.80.6.45:25094"
                    }
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "100.80.6.45:25094"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
