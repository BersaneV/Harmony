FROM rust:1.99.1-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --release --locked --bin harmony-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home harmony
COPY --from=build /build/target/release/harmony-server /usr/local/bin/harmony-server
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["harmony-server"]
