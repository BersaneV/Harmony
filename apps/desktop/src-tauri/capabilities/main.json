{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Janela local Harmony: sessão, links HTTP/HTTPS, notificações, F9 e atualizações assinadas pelo canal fixo.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-session-storage",
    "deep-link:default",
    "allow-open-external",
    "notification:default",
    "allow-push-to-talk",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-signed-updates",
    "allow-native-capture",
    "allow-windows-audio"
  ]
}
