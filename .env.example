# Generate private values with python3 scripts/configure.py; do not copy placeholders into production.
DATABASE_URL=sqlite:./data/harmony.db
HARMONY_BIND=127.0.0.1:8080
HARMONY_PUBLIC_API_URL=http://127.0.0.1:8080
HARMONY_PUBLIC_ORIGIN=http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
HARMONY_JWT_SECRET=CHANGE_ME_USE_CONFIGURE_SCRIPT
HARMONY_BOOTSTRAP_USERNAME=admin
HARMONY_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_CONFIGURE_SCRIPT
HARMONY_INSTANCE_NAME=Harmony
HARMONY_STORAGE_BACKEND=local
HARMONY_STORAGE_DIR=./data/files
HARMONY_MAX_UPLOAD_BYTES=26214400
HARMONY_STORAGE_QUOTA_BYTES=1073741824
HARMONY_MAX_VIDEO_BITRATE=32000000
HARMONY_MAX_ROOM_PARTICIPANTS=12
# Real calls use direct WebRTC by default. LiveKit is an explicit optional mode.
HARMONY_MEDIA_TRANSPORT=p2p
# STUN discovers network routes; it does not relay media. Empty disables STUN.
HARMONY_CALL_STUN_URLS=stun:stun.l.google.com:19302
HARMONY_P2P_DIAGNOSTICS=true
# Optional, operator-selected public STUN services. Empty means local candidates only.
HARMONY_P2P_STUN_URLS=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_USE_CONFIGURE_SCRIPT
